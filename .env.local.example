DATABASE_URL="file:./dev.db"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# PayHere
# APP_URL must be publicly reachable in live/sandbox callback testing so
# PayHere can POST to /api/payhere/webhook.
PAYHERE_MODE="sandbox"
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_APP_ID=""
PAYHERE_APP_SECRET=""

# SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dressing Bear <no-reply@example.com>"

# Brand
BRAND_NAME="Dressing Bear"
# Brand-side email address. Receives dispatch notifications, pending-prepaid
# alerts, order-confirmation BCCs, and failure alerts.
# Production value: dressingbear@gmail.com
BRAND_EMAIL="dressingbear@gmail.com"
CONTACT_NUMBER="+94 740545536"

# Royal Express / Curfox Courier
ROYAL_EXPRESS_ENABLED="false"
ROYAL_EXPRESS_USER="your-email@example.com"
ROYAL_EXPRESS_PASS="your-password"
ROYAL_EXPRESS_TENANT="royalexpress"

# Curfox API Config
CURFOX_MERCHANT_BUSINESS_ID="7290"
CURFOX_BASE_URL="https://v2-operations.api.curfox.com"
CURFOX_LOGIN_BASE_URL="https://v1.api.curfox.com"
CURFOX_ORDER_CREATE_PATH="/api/merchant/order/single"
CURFOX_WAYBILL_PDF_PATH_TEMPLATE="/api/merchant/order/print/{waybill_number}"
CURFOX_ORIGIN_CITY_ID="1500"
CURFOX_ORIGIN_WAREHOUSE_ID="78"
CURFOX_DEFAULT_WEIGHT_KG="1"

# Koko (Pay in 3) — set KOKO_ENABLED=true to show at checkout after sandbox testing.
# KOKO_MODE selects the endpoint: "test" -> qaapi.paykoko.com, "live" -> prodapi.paykoko.com.
# The merchant/API/RSA keys issued in the developer preview are QA-ONLY — keep
# KOKO_MODE="test" until Koko issues production keys, or orderCreate returns
# merchantPluginDetail.notExists. The QA sample (phpqa.php) uses pluginVersion 1.0.1.
# See SG-3 in docs/superpowers/plans/2026-05-28-koko-mintpay-payment-integration.md.
KOKO_ENABLED="false"
KOKO_MODE="test"
KOKO_MERCHANT_ID=""
KOKO_API_KEY=""
KOKO_PUBLIC_KEY=""
KOKO_PRIVATE_KEY=""
KOKO_PLUGIN_NAME="customapi"
KOKO_PLUGIN_VERSION="1.0.1"

# Mintpay — set MINTPAY_ENABLED=true to show at checkout after sandbox testing
MINTPAY_ENABLED="false"
MINTPAY_MODE="test"
MINTPAY_MERCHANT_ID=""
MINTPAY_MERCHANT_SECRET=""
