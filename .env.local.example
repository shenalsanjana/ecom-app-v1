APP_URL="http://localhost:3000"

# SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dressing Bear <no-reply@example.com>"

# Brand
BRAND_NAME="Dressing Bear"
BRAND_EMAIL="dressingbear@gmail.com"
CONTACT_NUMBER="+94 740545536"

# RoyalExpress (delivery courier API). Disabled by default; set ENABLED to
# "true" only after confirming the API endpoint URL accepts the order POST.
ROYAL_EXPRESS_ENABLED="false"
ROYAL_EXPRESS_API="https://royalexpress.merchant.curfox.com/add-new-order"
ROYAL_EXPRESS_USER=""
ROYAL_EXPRESS_PASS=""
ROYAL_EXPRESS_TENANT="royalexpress"

# Curfox courier (Royal Express) — endpoint configuration. Paths below were
# verified against the live API on 2026-05-16 (see Validation log in the
# design spec). Override only when Curfox confirms a new path.
CURFOX_BASE_URL="https://v2-operations.api.curfox.com"
CURFOX_LOGIN_BASE_URL="https://v1.api.curfox.com"
CURFOX_ORDER_CREATE_PATH="/api/merchant/order/single"
# Template substitutes only {waybill_number} — Curfox's create-order response
# does not include the numeric order id. Exact path TBD until confirmed via
# the merchant portal's network traffic.
CURFOX_WAYBILL_PDF_PATH_TEMPLATE="/api/merchant/order/print/{waybill_number}"
# No working cities endpoint discovered yet; kept for the admin refresh route.
CURFOX_CITIES_PATH="/api/merchant/city"
# Identifiers for the Dressing Bear merchant business — pinned from the
# /api/merchant/business response.
CURFOX_MERCHANT_BUSINESS_ID="7290"
CURFOX_ORIGIN_CITY_ID="1500"
CURFOX_ORIGIN_WAREHOUSE_ID="78"
CURFOX_DEFAULT_WEIGHT_KG="1"
