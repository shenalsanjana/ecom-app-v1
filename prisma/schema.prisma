datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String?   @unique
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  passwordHash    String?
  role            String    @default("CUSTOMER") @db.VarChar(16)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  wishlist      WishlistItem[]
  resetTokens   PasswordResetToken[]
  orders        Order[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String
  line1       String
  line2       String?
  city        String
  country     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  slug      String  @id
  name      String
  navLabel  String
  tileName  String
  note      String?
  subName   String?
  hex       String
  sortOrder Int     @default(0)

  designs     Design[]
  products    Product[]
  slugHistory DepartmentSlugHistory[]
}

model DepartmentSlugHistory {
  oldSlug     String     @id
  currentSlug String
  department  Department @relation(fields: [currentSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@index([currentSlug])
}

model Design {
  slug           String  @id
  name           String
  departmentSlug String
  image          String?
  hex            String
  sortOrder      Int     @default(0)
  dtfDesignId    String?

  department  Department          @relation(fields: [departmentSlug], references: [slug])
  dtfDesign   DtfDesign?          @relation(fields: [dtfDesignId], references: [id], onDelete: SetNull)
  products    Product[]
  discountTargets DiscountCategory[]
  additionalProducts ProductCollection[]
  slugHistory DesignSlugHistory[]

  @@index([departmentSlug])
}

model DesignSlugHistory {
  oldSlug     String @id
  currentSlug String
  design      Design @relation(fields: [currentSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@index([currentSlug])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum StockMode {
  PRINTED_TO_ORDER
  PLAIN
}

model Product {
  id            String   @id
  name          String
  price         Float
  originalPrice Float?
  description   String
  designSlug    String
  departmentSlug String
  archived      Boolean  @default(false)
  status        ProductStatus @default(DRAFT)
  stockMode     StockMode @default(PRINTED_TO_ORDER)
  dtfDesignId   String?
  inventoryProductId String?

  design        Design         @relation(fields: [designSlug], references: [slug])
  department    Department     @relation(fields: [departmentSlug], references: [slug])
  dtfDesign     DtfDesign?     @relation(fields: [dtfDesignId], references: [id], onDelete: Restrict)
  inventoryProduct InventoryProduct? @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)
  wishlistItems WishlistItem[]
  reviews       Review[]
  orderItems    OrderItem[]
  slugHistory   ProductSlugHistory[]
  variants      ProductVariant[]
  discountTargets DiscountProduct[]
  additionalCollections ProductCollection[]

  @@index([designSlug])
  @@index([departmentSlug])
  @@index([archived])
  @@index([status, archived])
  @@index([dtfDesignId])
  @@index([inventoryProductId])
}

// Extra storefront placements only. The primary collection stays on Product.
model ProductCollection {
  productId  String
  designSlug String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  design  Design  @relation(fields: [designSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, designSlug])
  @@index([designSlug])
}

model ProductSlugHistory {
  oldSlug   String  @id
  currentId String
  product   Product @relation(fields: [currentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([currentId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  color         String                     // display, e.g. "Baby Pink"
  colorSlug     String                     // url-safe, used in ?color=
  swatchHex     String?                    // swatch dot color; null => use first CARD image
  sku           String?  @unique           // optional; unique when present
  price         Float?                     // optional override; null => Product.price
  originalPrice Float?                     // optional override; null => Product.originalPrice
  sortOrder     Int      @default(0)       // lowest = default color
  archived      Boolean  @default(false)

  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  images     VariantImage[]
  sizeStocks VariantSizeStock[]
  orderItems OrderItem[]

  @@unique([productId, colorSlug])
  @@index([productId])
}

model VariantImage {
  id        String @id @default(cuid())
  variantId String
  url       String
  role      String @db.VarChar(8)          // "CARD" | "DETAIL"
  sortOrder Int    @default(0)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, role, sortOrder])
}

model VariantSizeStock {
  id        String @id @default(cuid())
  variantId String
  size      String
  sku       String @unique @default(dbgenerated("next_sale_sku()"))
  archived  Boolean @default(false)
  plainTshirtStockId String?

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  plainTshirtStock PlainTshirtStock? @relation(fields: [plainTshirtStockId], references: [id], onDelete: Restrict)

  @@unique([variantId, size])
  @@index([variantId])
  @@index([variantId, archived])
  @@index([plainTshirtStockId])
}

// Inventory navigation is independent of storefront departments/design URLs.
model InventoryCategory {
  id        String @id @default(cuid())
  name      String
  parentId  String?
  systemKey String? @unique
  version   Int @default(0)
  parent    InventoryCategory? @relation("InventoryCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  InventoryCategory[] @relation("InventoryCategoryTree")
  products  InventoryProduct[]

  @@unique([parentId, name])
  @@index([parentId])
}

// One physical product/blank family; existing store products are its designs.
model InventoryProduct {
  id         String @id @default(cuid())
  name       String
  categoryId String
  version    Int @default(0)
  category   InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  designs    Product[]
  stock      PlainTshirtStock[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

enum StockGroup {
  PLAIN_TSHIRT
  ACCESSORY
}

model PlainTshirtStock {
  id        String   @id @default(cuid())
  // color: display, e.g. "White"; colorSlug: matches ProductVariant.colorSlug
  color     String
  colorSlug String
  size      String
  quantity  Int      @default(0)
  version   Int      @default(0)
  stockGroup StockGroup @default(PLAIN_TSHIRT)
  inventoryProductId String?
  inventoryProduct InventoryProduct? @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  variantSizes VariantSizeStock[]
  movements StockMovement[]

  @@unique([inventoryProductId, colorSlug, size])
  // A partial SQL index keeps unassigned legacy colour/size entries unique.
  @@index([inventoryProductId])
}

model DtfDesign {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  quantity  Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs    Design[]
  products   Product[]
  orderItems OrderItem[]
  movements StockMovement[]
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  authorName  String
  rating      Int
  title       String?
  body        String
  createdAt   DateTime @default(now())
  synthetic   Boolean  @default(false)
  approved    Boolean  @default(false)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([approved])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id                    String   @id
  userId                String?
  guestName             String?
  guestEmail            String?
  customerPhone         String
  alternatePhone        String?   // optional secondary delivery phone; courier-only, order-scoped
  confirmationSmsSentAt DateTime? // idempotency stamp — customer order-confirmation SMS
  dispatchSmsSentAt     DateTime? // idempotency stamp — customer dispatch SMS
  cancellationSmsSentAt DateTime? // idempotency stamp — customer cancellation SMS
  purchaseTrackedAt     DateTime? // idempotency stamp — Meta Pixel Purchase event (claimed server-side, not client localStorage)
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingCountry       String
  subtotal              Float
  shippingCost          Float
  total                 Float
  paymentMethod         String
  paymentMethodDisplay  String
  paymentStatus         String?
  version               Int      @default(0)
  paymentStartedAt      DateTime?
  paymentReviewRequired Boolean  @default(false)
  paymentReviewReason   String?
  webNumber             String?   @unique
  rbNumber              String?   @unique
  status                String   @default("PENDING")
  deletedAt             DateTime?
  trackingCode          String?
  royalExpressSubmitted Boolean  @default(false)
  emailSent             Boolean  @default(false)
  // Curfox booking lifecycle
  courierWaybillNumber  String?
  courierBookedAt       DateTime?
  courierLastError      String?
  courierLastErrorAt    DateTime?
  dispatchPdfFetchedAt  DateTime?
  dispatchEmailSentAt   DateTime?
  customerDispatchEmailSentAt DateTime?
  deliveryCompany             String?
  adminAlertSentAt      DateTime?
  idempotencyKey        String?  @unique
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  notesLog              OrderNote[]
  adjustments           OrderAdjustment[]
  paymentEvents         PaymentEvent[]
  discountRedemption    DiscountRedemption?

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([status, courierBookedAt])
  @@index([paymentStatus, createdAt])
  @@index([deletedAt, createdAt])
}

// Verified gateway outcomes and reconciliation decisions, including late payments.
model PaymentEvent {
  id                String   @id @default(cuid())
  eventKey          String   @unique
  orderId           String
  provider          String
  outcome           String
  result            String
  providerReference String?
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model OrderItem {
  stockMode          StockMode @default(PRINTED_TO_ORDER)
  id                 String  @id @default(cuid())
  orderId            String
  // Nullable: a product may be hard-deleted while its order history lives on.
  // The line item keeps its own name/size/price/quantity snapshot, so deleting
  // the product (onDelete: SetNull) preserves the historical record.
  productId          String?
  variantId          String?
  color              String?
  sku                String?
  name               String
  size               String?
  price              Float
  quantity           Int
  plainTshirtStockId String?
  dtfDesignId        String?

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  plainTshirtStock PlainTshirtStock? @relation(fields: [plainTshirtStockId], references: [id], onDelete: Restrict)
  dtfDesign        DtfDesign?        @relation(fields: [dtfDesignId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([plainTshirtStockId])
  @@index([dtfDesignId])
}

model OrderNote {
  id          String   @id @default(cuid())
  orderId     String
  authorEmail String
  body        String
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderAdjustment {
  promotion Boolean @default(false)
  id        String   @id @default(cuid())
  orderId   String
  label     String
  amount    Float
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PhoneChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @db.VarChar(16) // "SIGNUP" | "RESET" | "NOTICE" (throttle-only marker for the already-registered signup branch; never verifiable)
  payload    String?                    // SIGNUP: JSON { name, email, passwordHash }
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

model CurfoxCity {
  id                  Int      @id
  name                String
  defaultWarehouseId  Int?
  updatedAt           DateTime @updatedAt

  @@index([name])
}

/// Singleton row (id is always "singleton") holding admin-editable store
/// settings. Seeded lazily from app/_lib/store-settings.ts defaults on first read.
model StoreSettings {
  id                    String   @id @default("singleton")
  storeName             String
  supportEmail          String
  supportPhone          String
  businessAddress       String
  colomboDeliveryCost   Int
  otherDeliveryCost     Int
  freeDeliveryThreshold Int
  updatedAt             DateTime @updatedAt
}

// Available-balance audit. Pool identities and labels are frozen at the event.
model StockMovement {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  plainTshirtStockId String?
  dtfDesignId String?
  plainTshirtStock PlainTshirtStock? @relation(fields: [plainTshirtStockId], references: [id], onDelete: Restrict)
  dtfDesign DtfDesign? @relation(fields: [dtfDesignId], references: [id], onDelete: Restrict)
  stockLabel String
  stockVersion Int
  before Int
  after Int
  delta Int
  reason String
  actorType String
  actorId String?
  orderId String?
  operationKey String
  createdAt DateTime @default(now())

  @@unique([plainTshirtStockId, stockVersion])
  @@unique([dtfDesignId, stockVersion])
  @@index([createdAt, id])
  @@index([orderId])
  @@index([operationKey])
}

// Idempotent staff stock-write intents; recorded in the same transaction.
model StockOperation {
  key String @id
  actorId String
  payloadHash String
  createdAt DateTime @default(now())
}

// Promotion money is stored as integer LKR cents; PERCENTAGE value is basis points.
model Discount {
  id               String @id @default(cuid())
  name             String
  code             String? @unique
  type             String @db.VarChar(16)
  scope            String @db.VarChar(16)
  value            Int
  active           Boolean @default(false)
  publicOffer      Boolean @default(false)
  paymentMethods   String[] @default([])
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?
  usedCount        Int @default(0)
  minimumOrder     Int @default(0)
  maximumDiscount  Int?
  version          Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  products         DiscountProduct[]
  categories       DiscountCategory[]
  redemptions      DiscountRedemption[]

  @@index([active, code])
}

model DiscountProduct {
  discountId String
  productId String
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@id([discountId, productId])
  @@index([productId])
}

model DiscountCategory {
  discountId String
  designSlug String
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)
  @@id([discountId, designSlug])
  @@index([designSlug])
}

// Immutable snapshot survives editing/deleting the promotion. One promotion per order.
model DiscountRedemption {
  id           String @id @default(cuid())
  discountId   String?
  orderId      String @unique
  name         String
  code         String?
  amount       Int
  createdAt    DateTime @default(now())
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([discountId, createdAt])
}
